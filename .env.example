DATABASE_URL=postgresql+psycopg://smartfinance:senha@localhost:5432/smartfinance
# Banco usado pela suíte de testes. A suíte DROPA e recria esse banco a cada
# execução, então ele nunca pode apontar pro mesmo da DATABASE_URL (tests/
# conftest.py aborta se apontar). Se você omitir, é derivado da DATABASE_URL
# acrescentando `_test` ao nome do banco — que é o suficiente na maioria dos casos.
# DATABASE_URL_TEST=postgresql+psycopg://smartfinance:senha@localhost:5432/smartfinance_test
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Cookie de sessão (api/deps.py) só é enviado pelo navegador em HTTPS quando
# Secure=true. Produção (atrás de nginx com TLS): deixe true (padrão se
# omitida). Dev local em http://localhost: defina false no seu .env real,
# senão login "funciona" mas o cookie nunca volta nas próximas requisições.
COOKIE_SECURE=true
